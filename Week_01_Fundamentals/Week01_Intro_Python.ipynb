# 🇪🇸 Objetivo:
# Familiarizarme con la sintaxis básica de Python, tipos de datos, variables y operaciones aritméticas.
# 🇬🇧 Objective:
# Get familiar with Python syntax, data types, variables, and arithmetic operations.

# 🇪🇸 Paso 1: Imprimir texto en consola
# 🇬🇧 Step 1: Print text to the console
print("¡Hola, Mediterranean Stays!")

# 🇪🇸 Paso 2: Crear variables
# 🇬🇧 Step 2: Create variables
ingresos_mensuales = 2500
gastos_mensuales = 1500

# 🇪🇸 Paso 3: Calcular rentabilidad
# 🇬🇧 Step 3: Calculate profitability
beneficio = ingresos_mensuales - gastos_mensuales
print("Beneficio mensual:", beneficio, "€")

# 🇪🇸 Paso 4: Crear una función reutilizable
# 🇬🇧 Step 4: Create a reusable function
def rentabilidad(ingresos, gastos):
    beneficio = ingresos - gastos
    rentabilidad_pct = (beneficio / ingresos) * 100
    return rentabilidad_pct

# 🇪🇸 Paso 5: Llamar a la función
# 🇬🇧 Step 5: Call the function
print("Rentabilidad:", rentabilidad(2500, 1500), "%")
