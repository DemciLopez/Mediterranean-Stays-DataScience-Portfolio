# 🧩 Week 02 – Data Structures & Functions
# 🇪🇸 Estructuras de datos y funciones | 🇬🇧 Data structures & functions

# ---
# 🎯 ES Objetivo:
# Practicar listas, tuplas, diccionarios, sets y funciones (incluyendo parámetros por defecto y lambdas).
# 🎯 EN Objective:
# Practice lists, tuples, dictionaries, sets, and functions (including default params and lambdas).

# =============================================================================
# 1) LISTAS / LISTS
# =============================================================================
# ES: Las listas son colecciones mutables (se pueden cambiar)
# EN: Lists are mutable collections (they can be modified)
zonas = ["Alicante", "Benidorm", "Denia"]
zonas.append("Calpe")      # ES: añadir / EN: append
zonas.remove("Denia")      # ES: eliminar / EN: remove
print("ES Zonas:", zonas, "| EN Zones:", zonas)

# Ejercicio ES/EN:
# ES: añade "Altea" y muestra la longitud de la lista
# EN: add "Altea" and print the list length
zonas.append("Altea")
print("Len zonas:", len(zonas))

# =============================================================================
# 2) TUPLAS / TUPLES
# =============================================================================
# ES: Inmutables, ideales para datos que NO cambian
# EN: Immutable, ideal for data that should NOT change
coordenadas = (38.3452, -0.4810)   # (lat, lon)
print("Coordenadas:", coordenadas)

# =============================================================================
# 3) DICCIONARIOS / DICTIONARIES
# =============================================================================
# ES: Estructura clave→valor / EN: Key→value mapping
vivienda = {
    "nombre": "Villa Los Olivos",
    "ciudad": "Mutxamel",
    "precio_noche": 120,
    "noches_ocupadas": 18
}
print("Precio por noche:", vivienda["precio_noche"])

# Ejercicio ES/EN:
# ES: Crea 2 diccionarios más y guárdalos en una lista llamada 'portafolio'
# EN: Create 2 more dictionaries and save them into a list called 'portfolio'
portfolio = [
    vivienda,
    {"nombre": "Apartamento Sol", "ciudad": "Alicante", "precio_noche": 95, "noches_ocupadas": 21},
    {"nombre": "Casa Marina", "ciudad": "Calpe", "precio_noche": 150, "noches_ocupadas": 12}
]

# =============================================================================
# 4) SETS
# =============================================================================
# ES: Colecciones sin duplicados (útiles para limpiar datos)
# EN: Collections without duplicates (useful for cleaning)
servicios = {"WiFi", "Piscina", "Aire acondicionado", "WiFi"}
print("Servicios (sin duplicados):", servicios)

# =============================================================================
# 5) FUNCIONES / FUNCTIONS
# =============================================================================
# ES: Función con parámetro por defecto / EN: Default parameter
def ingreso_mensual(precio_noche, noches):
    return precio_noche * noches

def beneficio(precio_noche, noches, gastos=400):
    ingreso = ingreso_mensual(precio_noche, noches)
    return ingreso - gastos

print("Beneficio ejemplo:", beneficio(120, 18))  # usa gastos=400 por defecto

# ES: Lambda para seleccionar la propiedad más cara
# EN: Lambda to pick the most expensive property
mas_cara = max(portfolio, key=lambda p: p["precio_noche"])
print("Propiedad más cara:", mas_cara["nombre"])

# =============================================================================
# 6) MINI-PROYECTO / MINI-PROJECT
# =============================================================================
# 🏡 ES: "Rental Price Manager"
# - Solicita al usuario 3 propiedades (nombre y tarifa)
# - Calcula la tarifa media
# - Exporta a CSV
# 🏡 EN: Ask the user for 3 properties (name, nightly rate), compute average, export to CSV

import csv

propiedades = []
for i in range(3):
    nombre = input(f"ES/EN Nombre/Name propiedad {i+1}: ")
    tarifa = float(input("ES/EN Precio/Price (€): "))
    propiedades.append({"nombre": nombre, "tarifa": tarifa})

media = sum(p["tarifa"] for p in propiedades) / len(propiedades)
print(f"ES Media tarifas: {media:.2f} € | EN Avg rate: {media:.2f} €")

with open("precios_viviendas.csv", "w", newline="") as f:
    w = csv.DictWriter(f, fieldnames=["nombre", "tarifa"])
    w.writeheader()
    w.writerows(propiedades)

